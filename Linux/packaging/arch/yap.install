post_install() {
  printf '%s\n' \
    '' \
    'Yap was installed without a speech model or compositor hotkey.' \
    'Complete setup as your desktop user:' \
    '' \
    '  yap model install' \
    '  yap doctor' \
    '  yap setup hyprland' \
    '' \
    'Yap will print the press/release commands for your own Hyprland binding.' \
    'For NVIDIA acceleration, install the optional ggml-cuda package.' \
    ''
}

post_upgrade() {
  printf '%s\n' \
    '' \
    'Yap was upgraded. Restart a running user daemon to load the new binary:' \
    '' \
    '  systemctl --user restart yap.service' \
    ''
}
