@dataclass(frozen=True)
class CheckView:
    status: str
    summary: str
    detail: str


@dataclass(frozen=True)
class DoctorView:
    compatibility: str
    checks: tuple[CheckView, ...]

    @classmethod
    def parse(cls, raw: str) -> "DoctorView":
        document = json.loads(raw)
        compatibility = str(document["compatibility"])
        checks = tuple(
            CheckView(str(item["status"]), str(item["summary"]), str(item["detail"]))
            for item in document["checks"]
        )
        return cls(compatibility, checks)


@dataclass(frozen=True)
class SettingsView:
    cleanup_intensity: str
    audio_mode: str
    duck_level: float
    trim_courtesy: bool


@dataclass(frozen=True)
class SnippetView:
    id: int
    trigger: str
    expansion: str


@dataclass(frozen=True)
class HistoryView:
    id: int
    text: str
    app_name: str | None
    created_unix_ms: int


@dataclass(frozen=True)
class DataView:
    settings: SettingsView
    snippets: tuple[SnippetView, ...]
    history: tuple[HistoryView, ...]

    @classmethod
    def parse(cls, raw: str) -> "DataView":
        document = json.loads(raw)
        settings = document["settings"]
        return cls(
            settings=SettingsView(
                cleanup_intensity=str(settings["cleanup_intensity"]),
                audio_mode=str(settings["audio_mode"]),
                duck_level=float(settings["duck_level"]),
                trim_courtesy=bool(settings["trim_courtesy"]),
            ),
            snippets=tuple(
                SnippetView(int(item["id"]), str(item["trigger"]), str(item["expansion"]))
                for item in document["snippets"]
            ),
            history=tuple(
                HistoryView(
                    int(item["id"]),
                    str(item["text"]),
                    str(item["app_name"]) if item["app_name"] is not None else None,
                    int(item["created_unix_ms"]),
                )
                for item in document["history"]
            ),
        )


def self_test() -> int:
    assert APPLICATION_ID != BUS_NAME
    report = DoctorView.parse(
        '{"compatibility":"ready","checks":['
        '{"id":"model","status":"pass","summary":"Transcription model","detail":"verified"}'
        "]}"
    )
    assert report.compatibility == "ready"
    assert report.checks == (CheckView("pass", "Transcription model", "verified"),)
    data = DataView.parse(
        '{"version":1,"settings":{"cleanup_intensity":"high","audio_mode":"lower",'
        '"duck_level":0.25,"trim_courtesy":true},"snippets":[{"id":4,"trigger":'
        '"my address","expansion":"42 Yap Street"}],"history":[{"id":5,"text":'
        '"Hello","app_name":"Zed","created_unix_ms":1234}]}'
    )
    assert data.settings == SettingsView("high", "lower", 0.25, True)
    assert data.snippets == (SnippetView(4, "my address", "42 Yap Street"),)
    assert data.history == (HistoryView(5, "Hello", "Zed", 1234),)
    return 0


