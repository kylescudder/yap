        note.add_css_class("muted")
        page.append(note)
        return page

    def _code_row(self, label: str, command: str) -> object:
        row = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL, spacing=12)
        row.add_css_class("code-row")
        name = self.Gtk.Label(label=label, xalign=0)
        name.set_size_request(62, -1)
        row.append(name)
        code = self.Gtk.Label(label=command, xalign=0)
        code.add_css_class("code")
        code.set_hexpand(True)
        row.append(code)
        copy = self.Gtk.Button(label="Copy")
        copy.add_css_class("secondary")
        copy.connect("clicked", lambda _button: self.window.get_clipboard().set(command))
        row.append(copy)
        return row

    def _future_page(self, eyebrow: str, title: str, description: str) -> object:
        page = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=18)
        page.add_css_class("content")
        page.append(self._page_header(eyebrow.upper(), title, description))
        card = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=10)
        card.add_css_class("card")
        mark = self.Gtk.Label(label="FULL PARITY WORK IN PROGRESS", xalign=0)
        mark.add_css_class("future-mark")
        body = self.Gtk.Label(label="This surface is intentionally visible but does not pretend to store or change anything until the daemon owns the feature.", xalign=0, wrap=True)
        body.add_css_class("muted")
        card.append(mark)
        card.append(body)
        page.append(card)
        return page

    def _connect_daemon(self) -> None:
        try:
            self.connection = self.Gio.bus_get_sync(self.Gio.BusType.SESSION, None)
            self.connection.signal_subscribe(BUS_NAME, INTERFACE_NAME, "StateChanged", OBJECT_PATH, None, self.Gio.DBusSignalFlags.NONE, self._state_changed)
            result = self.connection.call_sync(BUS_NAME, OBJECT_PATH, INTERFACE_NAME, "State", None, self.GLib.VariantType.new("(ssbs)"), self.Gio.DBusCallFlags.NONE, 5_000, None)
            self._render_daemon(*result.unpack())
        except Exception as error:
            print(f"yap-ui: could not reach daemon: {error}", file=sys.stderr)
            self._render_daemon("idle", "", False, "daemon unavailable")

    def _state_changed(self, _connection: object, _sender: str, _path: str, _interface: str, _signal: str, parameters: object, *_user_data: object) -> None:
        self._render_daemon(*parameters.unpack())

    def _render_daemon(self, phase: str, action: str, locked: bool, last_error: str) -> None:
        for name in ("processing", "error"):
            self.hero_dot.remove_css_class(name)
        if last_error:
            self.hero_dot.add_css_class("error")
            self.hero_title.set_label("Yap needs attention")
            self.hero_detail.set_label("Open machine health for the actionable failure")
        elif phase in {"recording", "recording-locked", "awaiting-second-tap"}:
            mode = "Command Mode" if action == "command" else "Dictation"
            self.hero_title.set_label("Listening · hands-free" if locked else "Listening")
            self.hero_detail.set_label(f"{mode} is capturing locally")
        elif phase == "processing":
            self.hero_dot.add_css_class("processing")
            self.hero_title.set_label("Turning speech into text")
            self.hero_detail.set_label("Local models are processing this recording")
        else:
            self.hero_title.set_label("Ready to listen")
            self.hero_detail.set_label("Use your Hyprland binding in any application")

    def _refresh_health(self) -> None:
        self.refresh_button.set_sensitive(False)
        self.refresh_button.set_label("Checking…")

        def work() -> None:
            try:
                result = subprocess.run(["yap", "doctor", "--json"], capture_output=True, text=True, timeout=20, check=False)
                report = DoctorView.parse(result.stdout)
                self.GLib.idle_add(self._apply_health, report, "")
            except Exception as error:
                self.GLib.idle_add(self._apply_health, None, str(error))

        threading.Thread(target=work, daemon=True).start()

    def _apply_health(self, report: DoctorView | None, error: str) -> bool:
        self.refresh_button.set_sensitive(True)
        self.refresh_button.set_label("Refresh")
        while child := self.checks_box.get_first_child():
            self.checks_box.remove(child)

        if report is None:
            label = self.Gtk.Label(label=f"Health check failed: {error}", xalign=0, wrap=True)
            label.add_css_class("muted")
            self.checks_box.append(label)
            self._set_compatibility("blocked")
            return self.GLib.SOURCE_REMOVE

        self._set_compatibility(report.compatibility)
        needs_model = False
        for check in report.checks:
            needs_model = needs_model or (check.summary == "Transcription model" and check.status == "setup_required")
            row = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class("check-row")
            dot = self.Gtk.Box()
            dot.add_css_class("check-dot")
            dot.add_css_class(check.status)
            dot.set_valign(self.Gtk.Align.CENTER)
            row.append(dot)
            copy = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=2)
            copy.set_hexpand(True)
            title = self.Gtk.Label(label=check.summary, xalign=0)
            title.add_css_class("check-title")
            detail = self.Gtk.Label(label=check.detail, xalign=0)
            detail.set_ellipsize(self.Pango.EllipsizeMode.END)
            detail.add_css_class("check-detail")
            detail.set_tooltip_text(check.detail)
            copy.append(title)
            copy.append(detail)
            row.append(copy)
            self.checks_box.append(row)
        self.model_button.set_visible(needs_model)
        return self.GLib.SOURCE_REMOVE

    def _set_compatibility(self, compatibility: str) -> None:
        for name in ("ready", "degraded", "setup_required", "blocked"):
            self.compatibility_badge.remove_css_class(name)
        self.compatibility_badge.add_css_class(compatibility)
        self.compatibility_badge.set_label(compatibility.replace("_", " ").upper())

    def _install_model(self, _button: object) -> None:
        self.model_button.set_sensitive(False)
        self.model_button.set_label("Installing and verifying…")

        def work() -> None:
            result = subprocess.run(["yap", "model", "install"], capture_output=True, text=True, check=False)
            message = result.stderr.strip() or result.stdout.strip()
            self.GLib.idle_add(self._model_finished, result.returncode, message)

        threading.Thread(target=work, daemon=True).start()

    def _model_finished(self, returncode: int, message: str) -> bool:
        self.model_button.set_sensitive(True)
        self.model_button.set_label("Install local speech model")
        if returncode == 0:
            self._refresh_health()
        else:
            self.hero_dot.add_css_class("error")
            self.hero_title.set_label("Model installation failed")
            self.hero_detail.set_label(message.splitlines()[-1] if message else "Run yap model install in a terminal")
        return self.GLib.SOURCE_REMOVE


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Open Yap's Linux desktop dashboard")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.self_test:
        return self_test()
    return Dashboard().run()


if __name__ == "__main__":
    raise SystemExit(main())
