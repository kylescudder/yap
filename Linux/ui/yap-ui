    def _hotkeys_page(self) -> object:
        page = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=22)
        page.add_css_class("content")
        page.append(self._page_header("SETTINGS", "Compositor-owned by design.", "Yap never rewrites your Hyprland configuration or claims a modifier."))

        card = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=12)
