#!/usr/bin/python
"""Yap's GTK4 dashboard for Linux setup, health, and feature surfaces."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import threading
from dataclasses import dataclass


BUS_NAME = "com.yap.Yap"
OBJECT_PATH = "/com/yap/Yap/Dictation"
INTERFACE_NAME = "com.yap.Yap.Dictation1"
APPLICATION_ID = "com.yap.Yap.Dashboard"


@dataclass(frozen=True)
class CheckView:
    status: str
    summary: str
    detail: str


@dataclass(frozen=True)
class DoctorView:
    compatibility: str
    checks: tuple[CheckView, ...]

    @classmethod
    def parse(cls, raw: str) -> "DoctorView":
        document = json.loads(raw)
        compatibility = str(document["compatibility"])
        checks = tuple(
            CheckView(str(item["status"]), str(item["summary"]), str(item["detail"]))
            for item in document["checks"]
        )
        return cls(compatibility, checks)


def self_test() -> int:
    assert APPLICATION_ID != BUS_NAME
    report = DoctorView.parse(
        '{"compatibility":"ready","checks":['
        '{"id":"model","status":"pass","summary":"Transcription model","detail":"verified"}'
        "]}"
    )
    assert report.compatibility == "ready"
    assert report.checks == (CheckView("pass", "Transcription model", "verified"),)
    return 0


