        form = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=9)
        form.add_css_class("card")
        title = self.Gtk.Label(label="Snippet editor", xalign=0)
        title.add_css_class("section-title")
        form.append(title)
        trigger_label = self.Gtk.Label(label="SPOKEN TRIGGER", xalign=0)
        trigger_label.add_css_class("field-label")
        form.append(trigger_label)
        self.snippet_trigger = self.Gtk.Entry(placeholder_text="for example: my address")
        self.snippet_trigger.add_css_class("form-field")
        form.append(self.snippet_trigger)
        expansion_label = self.Gtk.Label(label="EXPANSION", xalign=0)
        expansion_label.add_css_class("field-label")
        form.append(expansion_label)
        expansion_scroller = self.Gtk.ScrolledWindow()
        expansion_scroller.set_min_content_height(86)
        self.snippet_expansion = self.Gtk.TextView(wrap_mode=self.Gtk.WrapMode.WORD_CHAR)
        self.snippet_expansion.add_css_class("form-field")
        expansion_scroller.set_child(self.snippet_expansion)
        form.append(expansion_scroller)
        form_actions = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL, spacing=10)
        self.snippet_save_button = self.Gtk.Button(label="Add snippet")
        self.snippet_save_button.add_css_class("primary")
        self.snippet_save_button.connect("clicked", self._save_snippet)
        form_actions.append(self.snippet_save_button)
        self.snippet_cancel_button = self.Gtk.Button(label="Cancel edit")
        self.snippet_cancel_button.add_css_class("secondary")
        self.snippet_cancel_button.connect("clicked", lambda _button: self._reset_snippet_form())
        self.snippet_cancel_button.set_visible(False)
        form_actions.append(self.snippet_cancel_button)
        self.snippet_note = self.Gtk.Label(label="", xalign=0)
        self.snippet_note.add_css_class("save-note")
        self.snippet_note.set_hexpand(True)
