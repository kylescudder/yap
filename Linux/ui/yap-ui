    def _connect_daemon(self) -> None:
        try:
            self.connection = self.Gio.bus_get_sync(self.Gio.BusType.SESSION, None)
            self.connection.signal_subscribe(BUS_NAME, INTERFACE_NAME, "StateChanged", OBJECT_PATH, None, self.Gio.DBusSignalFlags.NONE, self._state_changed)
            self.connection.signal_subscribe(BUS_NAME, INTERFACE_NAME, "DataChanged", OBJECT_PATH, None, self.Gio.DBusSignalFlags.NONE, self._data_changed)
            result = self.connection.call_sync(BUS_NAME, OBJECT_PATH, INTERFACE_NAME, "State", None, self.GLib.VariantType.new("(ssbs)"), self.Gio.DBusCallFlags.NONE, 5_000, None)
            self._render_daemon(*result.unpack())
            self._apply_data(DataView.parse(self._call_data("Data")))
        except Exception as error:
            print(f"yap-ui: could not reach daemon: {error}", file=sys.stderr)
            self._render_daemon("idle", "", False, "daemon unavailable")

    def _state_changed(self, _connection: object, _sender: str, _path: str, _interface: str, _signal: str, parameters: object, *_user_data: object) -> None:
        self._render_daemon(*parameters.unpack())

    def _data_changed(self, _connection: object, _sender: str, _path: str, _interface: str, _signal: str, parameters: object, *_user_data: object) -> None:
        try:
            self._apply_data(DataView.parse(parameters.unpack()[0]))
        except Exception as error:
            print(f"yap-ui: invalid local state update: {error}", file=sys.stderr)

    def _call_data(self, method: str, parameters: object | None = None) -> str:
        result = self.connection.call_sync(
            BUS_NAME,
            OBJECT_PATH,
            INTERFACE_NAME,
            method,
            parameters,
            self.GLib.VariantType.new("(s)"),
            self.Gio.DBusCallFlags.NONE,
            5_000,
            None,
        )
        return str(result.unpack()[0])

    def _apply_data(self, data: DataView) -> None:
        self.data = data
        self.cleanup_combo.set_active_id(data.settings.cleanup_intensity)
        self.audio_combo.set_active_id(data.settings.audio_mode)
        self.duck_scale.set_value(data.settings.duck_level * 100)
        self.courtesy_switch.set_active(data.settings.trim_courtesy)
        self._audio_mode_changed(self.audio_combo)
        self._render_history(data.history)
        self._render_snippets(data.snippets)

    def _audio_mode_changed(self, _combo: object) -> None:
        self.duck_scale.set_sensitive(self.audio_combo.get_active_id() == "lower")

    def _save_settings(self, _button: object) -> None:
        payload = json.dumps(
            {
                "cleanup_intensity": self.cleanup_combo.get_active_id() or "medium",
                "audio_mode": self.audio_combo.get_active_id() or "pause",
                "duck_level": self.duck_scale.get_value() / 100,
                "trim_courtesy": self.courtesy_switch.get_active(),
            },
            separators=(",", ":"),
        )
        try:
            raw = self._call_data("UpdateSettings", self.GLib.Variant("(s)", (payload,)))
            self._apply_data(DataView.parse(raw))
            self._set_note(self.settings_note, "Saved locally", False)
        except Exception as error:
            self._set_note(self.settings_note, f"Could not save: {error}", True)

    def _render_history(self, history: tuple[HistoryView, ...]) -> None:
        while child := self.history_box.get_first_child():
            self.history_box.remove(child)
        self.history_count.set_label(f"{len(history)} entr{'y' if len(history) == 1 else 'ies'}")
        if not history:
            empty = self.Gtk.Label(label="No dictations yet. Successfully inserted text will appear here.", wrap=True)
            empty.add_css_class("empty-state")
            self.history_box.append(empty)
            return
        for entry in history:
            row = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=7)
            row.add_css_class("item-row")
            heading = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL, spacing=10)
            date = datetime.datetime.fromtimestamp(entry.created_unix_ms / 1000).astimezone()
            meta = self.Gtk.Label(label=f"{entry.app_name or 'Unknown app'} · {date:%d %b %Y, %H:%M}", xalign=0)
            meta.add_css_class("item-meta")
            meta.set_hexpand(True)
            heading.append(meta)
            copy = self.Gtk.Button(label="Copy")
            copy.add_css_class("secondary")
            copy.connect("clicked", lambda _button, text=entry.text: self.window.get_clipboard().set(text))
            heading.append(copy)
            row.append(heading)
            body = self.Gtk.Label(label=entry.text, xalign=0, yalign=0, wrap=True, selectable=True)
            body.add_css_class("item-body")
            row.append(body)
            self.history_box.append(row)

    def _clear_history(self, _button: object) -> None:
        try:
            self._apply_data(DataView.parse(self._call_data("ClearHistory")))
        except Exception as error:
            print(f"yap-ui: could not clear history: {error}", file=sys.stderr)

    def _render_snippets(self, snippets: tuple[SnippetView, ...]) -> None:
        while child := self.snippets_box.get_first_child():
            self.snippets_box.remove(child)
        if not snippets:
            empty = self.Gtk.Label(label="No snippets yet. Add a spoken trigger above.", wrap=True)
            empty.add_css_class("empty-state")
            self.snippets_box.append(empty)
            return
        for snippet in snippets:
            row = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class("item-row")
            copy = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=3)
            copy.set_hexpand(True)
            trigger = self.Gtk.Label(label=snippet.trigger, xalign=0)
            trigger.add_css_class("item-title")
            expansion = self.Gtk.Label(label=snippet.expansion, xalign=0, wrap=True)
            expansion.add_css_class("item-body")
            copy.append(trigger)
            copy.append(expansion)
            row.append(copy)
            edit = self.Gtk.Button(label="Edit")
            edit.add_css_class("secondary")
            edit.connect("clicked", lambda _button, item=snippet: self._edit_snippet(item))
            row.append(edit)
            remove = self.Gtk.Button(label="Delete")
            remove.add_css_class("danger")
            remove.connect("clicked", lambda _button, item_id=snippet.id: self._remove_snippet(item_id))
            row.append(remove)
            self.snippets_box.append(row)

    def _edit_snippet(self, snippet: SnippetView) -> None:
        self.editing_snippet_id = snippet.id
        self.snippet_trigger.set_text(snippet.trigger)
        self.snippet_expansion.get_buffer().set_text(snippet.expansion)
        self.snippet_save_button.set_label("Save changes")
        self.snippet_cancel_button.set_visible(True)
        self.snippet_trigger.grab_focus()

    def _save_snippet(self, _button: object) -> None:
        buffer = self.snippet_expansion.get_buffer()
        start, end = buffer.get_bounds()
        trigger = self.snippet_trigger.get_text().strip()
        expansion = buffer.get_text(start, end, True).strip()
        if not trigger or not expansion:
            self._set_note(self.snippet_note, "Trigger and expansion are required", True)
            return
        try:
            parameters = self.GLib.Variant("(tss)", (self.editing_snippet_id, trigger, expansion))
            self._apply_data(DataView.parse(self._call_data("SaveSnippet", parameters)))
            self._reset_snippet_form()
            self._set_note(self.snippet_note, "Saved locally", False)
        except Exception as error:
            self._set_note(self.snippet_note, f"Could not save: {error}", True)

    def _remove_snippet(self, snippet_id: int) -> None:
        try:
            parameters = self.GLib.Variant("(t)", (snippet_id,))
            self._apply_data(DataView.parse(self._call_data("RemoveSnippet", parameters)))
            if self.editing_snippet_id == snippet_id:
                self._reset_snippet_form()
        except Exception as error:
            self._set_note(self.snippet_note, f"Could not delete: {error}", True)

    def _reset_snippet_form(self) -> None:
        self.editing_snippet_id = 0
        self.snippet_trigger.set_text("")
        self.snippet_expansion.get_buffer().set_text("")
        self.snippet_save_button.set_label("Add snippet")
        self.snippet_cancel_button.set_visible(False)

    def _set_note(self, label: object, message: str, error: bool) -> None:
        label.set_label(message)
        if error:
            label.add_css_class("error")
        else:
            label.remove_css_class("error")

    def _render_daemon(self, phase: str, action: str, locked: bool, last_error: str) -> None:
        for name in ("processing", "error"):
            self.hero_dot.remove_css_class(name)
        if last_error:
            self.hero_dot.add_css_class("error")
            self.hero_title.set_label("Yap needs attention")
            self.hero_detail.set_label("Open machine health for the actionable failure")
        elif phase in {"recording", "recording-locked", "awaiting-second-tap"}:
            mode = "Command Mode" if action == "command" else "Dictation"
            self.hero_title.set_label("Listening · hands-free" if locked else "Listening")
            self.hero_detail.set_label(f"{mode} is capturing locally")
        elif phase == "processing":
            self.hero_dot.add_css_class("processing")
            self.hero_title.set_label("Turning speech into text")
            self.hero_detail.set_label("Local models are processing this recording")
        else:
            self.hero_title.set_label("Ready to listen")
            self.hero_detail.set_label("Use your Hyprland binding in any application")

    def _refresh_health(self) -> None:
        self.refresh_button.set_sensitive(False)
        self.refresh_button.set_label("Checking…")

        def work() -> None:
            try:
                result = subprocess.run(["yap", "doctor", "--json"], capture_output=True, text=True, timeout=20, check=False)
                report = DoctorView.parse(result.stdout)
                self.GLib.idle_add(self._apply_health, report, "")
            except Exception as error:
                self.GLib.idle_add(self._apply_health, None, str(error))

        threading.Thread(target=work, daemon=True).start()

    def _apply_health(self, report: DoctorView | None, error: str) -> bool:
        self.refresh_button.set_sensitive(True)
        self.refresh_button.set_label("Refresh")
        while child := self.checks_box.get_first_child():
            self.checks_box.remove(child)

        if report is None:
            label = self.Gtk.Label(label=f"Health check failed: {error}", xalign=0, wrap=True)
            label.add_css_class("muted")
            self.checks_box.append(label)
            self._set_compatibility("blocked")
            return self.GLib.SOURCE_REMOVE

        self._set_compatibility(report.compatibility)
        needs_model = False
        for check in report.checks:
            needs_model = needs_model or (
                check.summary in {"Transcription model", "Language model"}
                and check.status == "setup_required"
            )
            row = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class("check-row")
            dot = self.Gtk.Box()
            dot.add_css_class("check-dot")
            dot.add_css_class(check.status)
            dot.set_valign(self.Gtk.Align.CENTER)
            row.append(dot)
            copy = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=2)
            copy.set_hexpand(True)
            title = self.Gtk.Label(label=check.summary, xalign=0)
            title.add_css_class("check-title")
            detail = self.Gtk.Label(label=check.detail, xalign=0)
            detail.set_ellipsize(self.Pango.EllipsizeMode.END)
            detail.add_css_class("check-detail")
            detail.set_tooltip_text(check.detail)
            copy.append(title)
            copy.append(detail)
            row.append(copy)
            self.checks_box.append(row)
        self.model_button.set_label(
            "Install local models" if needs_model else "Verify or repair local models"
        )
        self.model_button.set_visible(True)
        return self.GLib.SOURCE_REMOVE

    def _set_compatibility(self, compatibility: str) -> None:
        for name in ("ready", "degraded", "setup_required", "blocked"):
            self.compatibility_badge.remove_css_class(name)
        self.compatibility_badge.add_css_class(compatibility)
        self.compatibility_badge.set_label(compatibility.replace("_", " ").upper())

    def _install_model(self, _button: object) -> None:
        self.model_button.set_sensitive(False)
        self.model_button.set_label("Installing and verifying…")
        self.model_progress.set_visible(True)

        def pulse() -> bool:
            self.model_progress.pulse()
            return self.GLib.SOURCE_CONTINUE

        self.model_progress_source = self.GLib.timeout_add(120, pulse)

        def work() -> None:
            result = subprocess.run(["yap", "model", "install"], capture_output=True, text=True, check=False)
            message = result.stderr.strip() or result.stdout.strip()
            self.GLib.idle_add(self._model_finished, result.returncode, message)

        threading.Thread(target=work, daemon=True).start()

    def _model_finished(self, returncode: int, message: str) -> bool:
        self.model_button.set_sensitive(True)
        self.model_button.set_label("Install or repair local models")
        self.model_progress.set_visible(False)
        if self.model_progress_source:
            self.GLib.source_remove(self.model_progress_source)
            self.model_progress_source = 0
        if returncode == 0:
            self._refresh_health()
        else:
            self.hero_dot.add_css_class("error")
            self.hero_title.set_label("Model installation failed")
            self.hero_detail.set_label(message.splitlines()[-1] if message else "Run yap model install in a terminal")
        return self.GLib.SOURCE_REMOVE


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Open Yap's Linux desktop dashboard")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.self_test:
        return self_test()
    return Dashboard().run()


if __name__ == "__main__":
    raise SystemExit(main())
