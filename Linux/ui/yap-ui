class Dashboard:
    def __init__(self) -> None:
        self.Gio, self.GLib, self.Gtk, self.Pango = load_gtk()
        self.application = self.Gtk.Application(application_id=APPLICATION_ID)
        self.application.connect("activate", self._activate)
        self.window = None
        self.stack = None
        self.nav_buttons: dict[str, object] = {}
        self.hero_dot = None
        self.hero_title = None
        self.hero_detail = None
        self.compatibility_badge = None
        self.checks_box = None
        self.refresh_button = None
        self.model_button = None
        self.connection = None

    def run(self) -> int:
        return self.application.run(None)

    def _activate(self, application: object) -> None:
        if self.window is not None:
            self.window.present()
            return

        self.window = self.Gtk.ApplicationWindow(application=application)
        self.window.set_title("Yap")
        self.window.set_default_size(920, 660)
        self.window.set_size_request(760, 560)
        self.window.add_css_class("yap-dashboard")

        provider = self.Gtk.CssProvider()
        provider.load_from_data(CSS)
        self.Gtk.StyleContext.add_provider_for_display(
            self.window.get_display(), provider, self.Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        shell = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL)
        shell.add_css_class("app-shell")
        shell.append(self._build_sidebar())

        self.stack = self.Gtk.Stack(transition_type=self.Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        self.stack.add_named(self._overview_page(), "overview")
        self.stack.add_named(self._hotkeys_page(), "settings")
        self.stack.add_named(self._future_page("History", "Local dictation history", "The daemon-backed history store is the next persistence slice."), "history")
        self.stack.add_named(self._future_page("Snippets", "Speak less. Insert more.", "Snippet storage and expansion will land with the shared persistence module."), "snippets")
        shell.append(self.stack)
        self.window.set_child(shell)
        self.window.present()

        self._connect_daemon()
        self._refresh_health()

    def _build_sidebar(self) -> object:
        sidebar = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=8)
        sidebar.add_css_class("sidebar")

        brand_row = self.Gtk.Box(orientation=self.Gtk.Orientation.HORIZONTAL, spacing=10)
        dot = self.Gtk.Box()
        dot.add_css_class("brand-dot")
        dot.set_valign(self.Gtk.Align.CENTER)
        brand = self.Gtk.Label(label="YAP", xalign=0)
        brand.add_css_class("brand")
        brand_row.append(dot)
        brand_row.append(brand)
        sidebar.append(brand_row)
        subtitle = self.Gtk.Label(label="LOCAL VOICE SYSTEM", xalign=0)
        subtitle.add_css_class("brand-subtitle")
        subtitle.set_margin_bottom(24)
        sidebar.append(subtitle)

        for name, label in (("overview", "Overview"), ("settings", "Settings"), ("history", "History"), ("snippets", "Snippets")):
            button = self.Gtk.Button(label=label)
            button.add_css_class("nav-button")
            button.set_halign(self.Gtk.Align.FILL)
            button.connect("clicked", self._navigate, name)
            self.nav_buttons[name] = button
            sidebar.append(button)
        self.nav_buttons["overview"].add_css_class("active")

        spacer = self.Gtk.Box()
        spacer.set_vexpand(True)
        sidebar.append(spacer)
        privacy = self.Gtk.Label(label="Speech stays on this machine", xalign=0, wrap=True)
        privacy.add_css_class("muted")
        sidebar.append(privacy)
        version = self.Gtk.Label(label="LINUX ALPHA · AUR BLOCKED", xalign=0)
        version.add_css_class("version")
        sidebar.append(version)
        return sidebar

    def _navigate(self, _button: object, name: str) -> None:
        self.stack.set_visible_child_name(name)
        for page, button in self.nav_buttons.items():
            if page == name:
                button.add_css_class("active")
            else:
                button.remove_css_class("active")

    def _page_header(self, eyebrow: str, title: str, subtitle: str) -> object:
        box = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=5)
        eye = self.Gtk.Label(label=eyebrow, xalign=0)
        eye.add_css_class("eyebrow")
        heading = self.Gtk.Label(label=title, xalign=0)
        heading.add_css_class("page-title")
        detail = self.Gtk.Label(label=subtitle, xalign=0, wrap=True)
        detail.add_css_class("muted")
        box.append(eye)
        box.append(heading)
        box.append(detail)
        return box

