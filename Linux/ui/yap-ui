        self.refresh_button.add_css_class("secondary")
        self.refresh_button.connect("clicked", lambda _button: self._refresh_health())
        heading.append(self.refresh_button)
        page.append(heading)

        scroller = self.Gtk.ScrolledWindow()
        scroller.set_policy(self.Gtk.PolicyType.NEVER, self.Gtk.PolicyType.AUTOMATIC)
        scroller.set_vexpand(True)
        self.checks_box = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL)
