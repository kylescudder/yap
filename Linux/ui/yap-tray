#!/usr/bin/python
"""StatusNotifier tray adapter for Yap's daemon and GTK dashboard."""

from __future__ import annotations

import argparse
import subprocess
import sys
from dataclasses import dataclass


BUS_NAME = "com.yap.Yap"
OBJECT_PATH = "/com/yap/Yap/Dictation"
INTERFACE_NAME = "com.yap.Yap.Dictation1"
DASHBOARD_ID = "com.yap.Yap.Dashboard"


@dataclass(frozen=True)
class TrayState:
    label: str
    attention: bool


def tray_state(phase: str, action: str, locked: bool, last_error: str) -> TrayState:
    if last_error:
        return TrayState("Yap needs attention", True)
    if phase == "processing":
        return TrayState("Yap is processing locally", False)
    if phase in {"recording", "recording-locked", "awaiting-second-tap"}:
        mode = "Command Mode" if action == "command" else "dictation"
        suffix = " · hands-free" if locked or phase == "recording-locked" else ""
        return TrayState(f"Yap is recording {mode}{suffix}", False)
    return TrayState("Yap is ready", False)


def self_test() -> int:
    assert tray_state("idle", "", False, "") == TrayState("Yap is ready", False)
    assert tray_state("recording", "command", False, "").label.endswith("Command Mode")
    assert tray_state("idle", "", False, "failure").attention
    return 0


def load_gtk() -> tuple[object, object, object, object]:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3, Gio, GLib, Gtk

    return AyatanaAppIndicator3, Gio, GLib, Gtk


class TrayApplication:
    def __init__(self) -> None:
        self.Indicator, self.Gio, self.GLib, self.Gtk = load_gtk()
        self.indicator = self.Indicator.Indicator.new(
            "yap-dictation",
            "com.yap.Yap",
            self.Indicator.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_status(self.Indicator.IndicatorStatus.ACTIVE)
        self.indicator.set_attention_icon_full("dialog-error-symbolic", "Yap needs attention")
        self.status_item = self.Gtk.MenuItem(label="Yap is connecting…")
        self.status_item.set_sensitive(False)
        self.indicator.set_menu(self._menu())
        self.connection = None

    def run(self) -> int:
        self._connect_daemon()
        self.Gtk.main()
        return 0

    def _menu(self) -> object:
        menu = self.Gtk.Menu()
        menu.append(self.status_item)
        menu.append(self.Gtk.SeparatorMenuItem())
        for label, page in (
            ("Overview and diagnostics…", "overview"),
            ("Settings…", "settings"),
            ("Dictation history…", "history"),
            ("Snippets…", "snippets"),
        ):
            item = self.Gtk.MenuItem(label=label)
            item.connect("activate", lambda _item, target=page: self._open_page(target))
            menu.append(item)
        menu.append(self.Gtk.SeparatorMenuItem())
        restart = self.Gtk.MenuItem(label="Restart Yap")
        restart.connect("activate", self._restart)
        menu.append(restart)
        quit_item = self.Gtk.MenuItem(label="Quit Yap for this session")
        quit_item.connect("activate", self._quit)
        menu.append(quit_item)
        menu.show_all()
        return menu

    def _connect_daemon(self) -> None:
        try:
            self.connection = self.Gio.bus_get_sync(self.Gio.BusType.SESSION, None)
            self.connection.signal_subscribe(
                BUS_NAME,
                INTERFACE_NAME,
                "StateChanged",
                OBJECT_PATH,
                None,
                self.Gio.DBusSignalFlags.NONE,
                self._state_changed,
            )
            result = self.connection.call_sync(
                BUS_NAME,
                OBJECT_PATH,
                INTERFACE_NAME,
                "State",
                None,
                self.GLib.VariantType.new("(ssbs)"),
                self.Gio.DBusCallFlags.NONE,
                5_000,
                None,
            )
            self._render(*result.unpack())
        except Exception as error:
            print(f"yap-tray: could not reach Yap: {error}", file=sys.stderr)
            self._render("idle", "", False, "daemon unavailable")

    def _state_changed(
        self,
        _connection: object,
        _sender: str,
        _path: str,
        _interface: str,
        _signal: str,
        parameters: object,
        *_user_data: object,
    ) -> None:
        self._render(*parameters.unpack())

    def _render(self, phase: str, action: str, locked: bool, last_error: str) -> None:
        state = tray_state(phase, action, locked, last_error)
        self.status_item.set_label(state.label)
        status = (
            self.Indicator.IndicatorStatus.ATTENTION
            if state.attention
            else self.Indicator.IndicatorStatus.ACTIVE
        )
        self.indicator.set_status(status)

    def _open_page(self, page: str) -> None:
        subprocess.Popen(
            ["yap", "gui"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

        def navigate() -> bool:
            subprocess.run(
                ["gapplication", "action", DASHBOARD_ID, "page", repr(page)],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=3,
                check=False,
            )
            return self.GLib.SOURCE_REMOVE

        self.GLib.timeout_add(350, navigate)

    def _restart(self, _item: object) -> None:
        subprocess.Popen(
            ["systemctl", "--user", "restart", "yap.service", "yap-overlay.service"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def _quit(self, _item: object) -> None:
        subprocess.run(
            ["systemctl", "--user", "stop", "yap.service", "yap-overlay.service"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
        self.Gtk.main_quit()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run Yap's desktop status indicator")
    parser.add_argument("--self-test", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.self_test:
        return self_test()
    return TrayApplication().run()


if __name__ == "__main__":
    raise SystemExit(main())
